# Required: Database (Supabase PostgreSQL)
# Pooled connection (Supabase Transaction pooler, port 6543) - used for normal app queries
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?sslmode=require"
# Direct connection (port 5432) - used only for running migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Required: Google Gemini API
GEMINI_API_KEY="your-gemini-api-key"

# Required: Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Required: Sentry (error monitoring)
# DSN is public (it ships in browser JS); used by client, server, and edge SDKs.
# Sentry only sends events from production builds.
NEXT_PUBLIC_SENTRY_DSN="https://your-key@o0.ingest.sentry.io/0"
# Build-time source map upload
SENTRY_AUTH_TOKEN="your-sentry-auth-token"
SENTRY_ORG="your-sentry-org-slug"
SENTRY_PROJECT="your-sentry-project-slug"

# Required: cron job authentication for /api/cron/keep-alive.
# Set it in the Vercel project env too; Vercel then sends it as a Bearer token.
# If unset or empty, the endpoint rejects every request with 401.
# Generate with: openssl rand -hex 32
CRON_SECRET="generate-a-long-random-string"

# Optional: Public app URL (used for SEO metadata/OG images)
# Set to your actual domain in production
NEXT_PUBLIC_APP_URL="https://giftclaw.vercel.app"
