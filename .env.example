# Required: Database (Supabase PostgreSQL)
# Pooled connection (Supabase Transaction pooler, port 6543) - used for normal app queries
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?sslmode=require&pgbouncer=true"
# Direct connection (port 5432) - used only for running migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Required: Google Gemini API
GEMINI_API_KEY="your-gemini-api-key"

# Required: Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Required: Sentry (error monitoring)
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# Auto-set by Vercel for cron job authentication (do not set manually in production)
# CRON_SECRET="auto-managed-by-vercel"

# Optional: Public app URL (used for SEO metadata/OG images)
# Set to your actual domain in production
NEXT_PUBLIC_APP_URL="https://giftclaw.vercel.app"
